<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Tutors no longer get the per-row actions on the exercise-scores page: participant identities and repository
         links in participation and score lists are visible to instructors only, so the per-exercise opt-in is gone. -->
    <changeSet id="20260922152337-01-drop-allow-tutor-score-row-actions" author="markus">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="exercise" columnName="allow_tutor_score_row_actions"/>
        </preConditions>
        <dropColumn tableName="exercise" columnName="allow_tutor_score_row_actions"/>
        <rollback>
            <addColumn tableName="exercise">
                <column name="allow_tutor_score_row_actions" type="boolean" defaultValueBoolean="false">
                    <constraints nullable="false"/>
                </column>
            </addColumn>
        </rollback>
    </changeSet>
</databaseChangeLog>
