<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- A customizable description shown in the "choose a variant" banner on the student group-detail page. Stored on
         both tables: exercise_variant_group.description backs a plain variant group directly, while exercise.description
         backs a MilestoneExercise - MilestoneExerciseGroup#getDescription/#setDescription delegate to the latter, the
         same way the group's timeline fields already delegate to the milestone exercise's own dates. -->
    <changeSet id="20260821120000-1" author="nschmitz">
        <addColumn tableName="exercise_variant_group">
            <column name="description" type="varchar(500)"/>
        </addColumn>
        <addColumn tableName="exercise">
            <column name="description" type="varchar(500)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
