<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Tracks when a student (re-)uploaded their programming exercise explanation video, so the student-facing
         widget can show "already uploaded" state including the upload timestamp. -->
    <changeSet id="20260730071809-01-add-explanation-video-upload-date-column" author="niklas.oelde">
        <addColumn tableName="participation">
            <column name="explanation_video_upload_date" type="datetime(3)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
